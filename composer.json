{
    "name": "open-dxp/mcp-bundle",
    "type": "opendxp-bundle",
    "license": "GPL-3.0-or-later",
    "description": "Model Context Protocol server for OpenDXP. Makes the running installation queryable for AI agents.",
    "keywords": [
        "opendxp",
        "mcp",
        "ai",
        "agent"
    ],
    "homepage": "https://github.com/open-dxp/mcp-bundle",
    "authors": [
        {
            "name": "DACHCOM.DIGITAL Stefan Hagspiel",
            "email": "shagspiel@dachcom.ch",
            "homepage": "https://www.dachcom.com/",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\McpBundle\\": "src"
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "open-dxp/opendxp": "^1.3",
        "symfony/mcp-bundle": "^0.13.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0"
    },
    "extra": {
        "opendxp": {
            "bundles": [
                "OpenDxp\\Bundle\\McpBundle\\OpenDxpMcpBundle"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": false,
            "php-http/discovery": true
        }
    }
}
